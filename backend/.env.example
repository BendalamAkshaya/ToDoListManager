# Environment variables for Django backend
# DO NOT COMMIT YOUR ACTUAL .env FILE

# Django Secret Key (generate a random string)
SECRET_KEY=your-secret-key-here

# Debug mode (set to False in production)
DEBUG=False

# Allowed Hosts (comma-separated, e.g., your-app.up.railway.app,localhost)
ALLOWED_HOSTS=localhost,127.0.0.1,*.up.railway.app

# Database URL (Railway provides this automatically as DATABASE_URL)
# DATABASE_URL=postgres://user:password@host:port/dbname

# CORS Allowed Origins (your Vercel frontend URL)
CORS_ALLOWED_ORIGINS=https://your-frontend-url.vercel.app,http://localhost:5173
